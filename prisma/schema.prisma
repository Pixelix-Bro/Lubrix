datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum ReminderChannel {
  SMS
  TELEGRAM
}

enum ReminderStatus {
  scheduled
  queued
  sending
  sent
  delivered
  failed
  cancelled
  suppressed
}

enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum IntervalSource {
  manual
  manufacturer
  recommendation
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  countryCode      String            @default("UZ") @map("country_code")
  timezone         String            @default("Asia/Tashkent")
  currency         String            @default("UZS")
  defaultLocale    String            @default("uz") @map("default_locale")
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  branches         Branch[]
  users            User[]
  customers        Customer[]
  vehicles         Vehicle[]
  serviceRecords   ServiceRecord[]
  reminders        Reminder[]
  messageLogs      MessageLog[]
  telegramLinks    TelegramLink[]
  subscriptions    Subscription[]
  auditLogs        AuditLog[]
  usageEvents      UsageEvent[]
  notificationSettings NotificationPreference[]

  @@map("organizations")
}

model Branch {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  address        String
  latitude       Float?
  longitude      Float?
  phone          String?
  timezone       String          @default("Asia/Tashkent")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceRecords ServiceRecord[]
  memberships    BranchMembership[]

  @@index([organizationId])
  @@map("branches")
}

model User {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  email          String          @unique
  phone          String?
  passwordHash   String          @map("password_hash")
  role           Role            @default(STAFF)
  status         UserStatus      @default(ACTIVE)
  lastLoginAt    DateTime?       @map("last_login_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdServices ServiceRecord[] @relation("ServiceCreatedBy")
  auditActions   AuditLog[]      @relation("UserAuditLogs")
  memberships    BranchMembership[]

  @@index([organizationId])
  @@map("users")
}

model BranchMembership {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  userId    String   @map("user_id")
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@map("branch_memberships")
}

model Customer {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  fullName           String          @map("full_name")
  phoneE164          String          @map("phone_e164")
  email              String?
  preferredLocale    String          @default("uz") @map("preferred_locale")
  smsConsentAt       DateTime?       @map("sms_consent_at")
  telegramConsentAt  DateTime?       @map("telegram_consent_at")
  optedOutAt         DateTime?       @map("opted_out_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles           Vehicle[]
  serviceRecords     ServiceRecord[]
  reminders          Reminder[]
  telegramLinks      TelegramLink[]
  preferences        NotificationPreference[]

  @@index([organizationId])
  @@index([organizationId, phoneE164])
  @@map("customers")
}

model Vehicle {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  customerId         String          @map("customer_id")
  plateNumber        String          @map("plate_number")
  plateCountry       String          @default("UZ") @map("plate_country")
  make               String
  model              String
  modelYear          Int?            @map("model_year")
  vin                String?
  currentOdometerKm  Int?            @map("current_odometer_km")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRecords     ServiceRecord[]
  reminders          Reminder[]

  @@index([organizationId])
  @@index([organizationId, plateNumber])
  @@map("vehicles")
}

model ServiceRecord {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  branchId        String          @map("branch_id")
  vehicleId       String          @map("vehicle_id")
  customerId      String          @map("customer_id")
  serviceDate     DateTime        @default(now()) @map("service_date")
  odometerKm      Int             @map("odometer_km")
  oilBrand        String          @map("oil_brand")
  oilType         String          @map("oil_type")
  viscosity       String
  oilQuantity     Float?          @map("oil_quantity")
  price           Decimal         @default(0.0) @db.Decimal(12, 2)
  nextDueDate     DateTime?       @map("next_due_date")
  nextDueKm       Int?            @map("next_due_km")
  intervalSource  IntervalSource  @default(recommendation) @map("interval_source")
  notes           String?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator         User?           @relation("ServiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  reminders       Reminder[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([serviceDate])
  @@map("service_records")
}

model Reminder {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  serviceRecordId String?         @map("service_record_id")
  vehicleId       String          @map("vehicle_id")
  customerId      String          @map("customer_id")
  channel         ReminderChannel @default(SMS)
  dueAt           DateTime        @map("due_at")
  status          ReminderStatus  @default(scheduled)
  idempotencyKey  String          @unique @map("idempotency_key")
  attempts        Int             @default(0)
  lastError       String?         @map("last_error")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceRecord   ServiceRecord?  @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messageLogs     MessageLog[]

  @@index([organizationId])
  @@index([dueAt, status])
  @@map("reminders")
}

model MessageLog {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  reminderId        String?         @map("reminder_id")
  channel           ReminderChannel
  provider          String          // "eskiz" | "telegram" | "playmobile"
  providerMessageId String?         @map("provider_message_id")
  status            String          // sent, delivered, failed
  cost              Decimal?        @db.Decimal(10, 4)
  sentAt            DateTime?       @map("sent_at")
  deliveredAt       DateTime?       @map("delivered_at")
  errorCode         String?         @map("error_code")
  payloadSummary    String?         @map("payload_summary")
  createdAt         DateTime        @default(now()) @map("created_at")

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reminder          Reminder?       @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([providerMessageId])
  @@map("message_logs")
}

model TelegramLink {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  customerId     String       @map("customer_id")
  telegramChatId String       @map("telegram_chat_id")
  token          String?      @unique
  verifiedAt     DateTime?    @map("verified_at")
  linkedAt       DateTime     @default(now()) @map("linked_at")
  status         String       @default("active")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([telegramChatId])
  @@map("telegram_links")
}

model NotificationTemplate {
  id             String       @id @default(uuid())
  organizationId String?      @map("organization_id")
  locale         String       @default("uz")
  channel        String       // SMS, TELEGRAM
  eventType      String       @map("event_type") // REMINDER_14_DAYS, REMINDER_3_DAYS, REMINDER_DUE
  body           String
  version        Int          @default(1)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("notification_templates")
}

model NotificationPreference {
  id                     String       @id @default(uuid())
  organizationId         String       @map("organization_id")
  customerId             String       @map("customer_id")
  channel                String       @default("SMS")
  serviceRemindersEnabled Boolean      @default(true) @map("service_reminders_enabled")
  locale                 String       @default("uz")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer               Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, channel])
  @@map("notification_preferences")
}

model Plan {
  id           String         @id @default(uuid())
  name         String         // Starter, Pro, Business, Enterprise
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("UZS")
  limitsJson   String?        @map("limits_json")
  featuresJson String?        @map("features_json")
  isActive     Boolean        @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @map("organization_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(active)
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("subscriptions")
}

model UsageEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  eventType      String       @map("event_type") // SMS_SENT, TELEGRAM_SENT, SERVICE_CREATED
  quantity       Int          @default(1)
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  metadata       String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType])
  @@map("usage_events")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  actorUserId    String?      @map("actor_user_id")
  action         String       // CREATE, UPDATE, DELETE, CANCEL, EXPORT
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  metadata       String?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType])
  @@map("audit_logs")
}

model WebhookEvent {
  id              String       @id @default(uuid())
  provider        String       // eskiz, telegram, click, payme
  externalEventId String?      @map("external_event_id")
  eventType       String       @map("event_type")
  payload         String
  processedAt     DateTime?    @map("processed_at")
  status          String       @default("pending")
  error           String?
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([provider, externalEventId])
  @@map("webhook_events")
}
